{
  "name": "qr-queue-buzzer",
  "version": "1.0.0",
  "private": true,
  "description": "QR code queue buzzer: customers scan, staff buzz their phone. Runs on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "npm run db:migrate && wrangler deploy",
    "test": "node --test \"test/**/*.test.ts\"",
    "vapid": "node scripts/gen-vapid.ts",
    "check": "wrangler types --env-file /dev/null --strict-vars=false --check && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types --env-file /dev/null --strict-vars=false",
    "smoke": "node scripts/smoke.ts",
    "db:migrate:local": "wrangler d1 migrations apply aqona --local",
    "db:migrate": "wrangler d1 migrations apply aqona --remote",
    "db:schema": "node scripts/auth-schema.ts > migrations/0001_auth.sql"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "http_ece": "^1.2.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.31",
    "better-auth": "^1.7.26"
  }
}
