{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqona",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  // Better Auth needs Node.js APIs (crypto, AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat"],
  // Keep the public https://aqona.<account>.workers.dev address on after every deploy.
  // Preview addresses stay off: preview versions would share the live queue.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // 127.0.0.1, not localhost: on WSL, Windows browsers can't reach "localhost" (IPv6) inside WSL.
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  // Page templates are bundled into the Worker as text.
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.txt", "**/*.svg"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "QUEUE", "class_name": "QueueDO" }]
  },
  // Accounts, sessions, login codes, workspaces and the list of queues.
  // Created in the Cloudflare dashboard (Storage & Databases → D1). `npm run deploy` applies migrations/ to it first.
  "d1_databases": [{ "binding": "DB", "database_name": "aqona", "database_id": "20348698-6725-4973-817f-61e455b73fca", "migrations_dir": "migrations" }],
  // "Take a number" limit: 10 joins a minute per queue and IP (counted per Cloudflare location, approximate).
  // Generous on purpose: customers on a shop's Wi-Fi, or on the same mobile network, can share one IP.
  "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // The free plan only allows SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueDO"] }],
  "vars": {
    // Public half of the push key (safe to publish). The private half is a secret:
    //   local: VAPID_PRIVATE_KEY in .dev.vars    deployed: npx wrangler secret put VAPID_PRIVATE_KEY
    "VAPID_PUBLIC_KEY": "BASvt5_OUiBwIjzKMhhAANAw79gwBrz3d5qLGcjou0DGSDNKyfdzAXRoyYQOWqdRZ8CgdI6sOnHnIF_Pwj3B6ZU",
    // Contact the push services can use. Change to a real mailto: or https: address before going live.
    "VAPID_SUBJECT": "mailto:test@example.com",
    // How login codes are delivered (no email sending until aqona.app is set up):
    //   "log"     live site, for testing: the code is written to the Worker's logs (dashboard → Workers → aqona → Logs,
    //             or `npx wrangler tail`). Only the account owner can read them, so only they can finish an email sign-in.
    //   "console" local dev (set in .dev.vars): the code is printed in the wrangler dev terminal.
    //   "off"     Google sign-in only.
    "EMAIL_MODE": "log",
    // Cloudflare Turnstile site key (public), used on log-in and "Take a number". This one is Cloudflare's
    // always-pass test key. The checks run only where the TURNSTILE_SECRET_KEY secret is set.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
